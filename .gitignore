__pycache__/
*.pyc
*.pyo

# generated output, not source
*.png
!docs/img/*.png
*.csv
*.hpgl
batch_log.txt
demo_*.txt
/INFO1
/MOHR1
*.jpg

# written by install.bat and install.command: the interpreter the dependencies
# went into, so the launchers start that one rather than whatever is first on
# PATH. Machine-specific, not source.
python-path.txt

# build debris
*.egg-info/
build/
dist/
*.rar

# Angelier's own executables. They are not ours to redistribute and must never
# reach this repository, which is public: the 2008 workshop distribution is
# unpacked here during development so the embedded FORMAT strings can be read,
# and an unguarded `git add -A` would otherwise commit it.
*.exe
20080409-workshop/

# field data: sessions and saved sites are the user's own measurements and do
# not belong in a code repository, private or not. The FOLDER is tracked, via
# its .gitkeep, so a fresh clone has somewhere to put them; the contents are
# not.
Session/*
!Session/.gitkeep
!Session/README.md
*.tec

# Scratch output from the research scripts. These name every site in the
# reference archive, its folder layout and in one case a colleague's name, so
# they are field data in all but format. Three of them had been committed and
# had to be removed from history before this repository could be made public;
# the patterns are here so it cannot happen again.
# The working data folder: where old-format TENSOR runs get dropped in for the
# survey window to read, together with the coordinate and phase files that go
# with them. All of it is unpublished field data and station positions. The
# whole tree is ignored, README included, because the only safe rule for a
# folder whose entire purpose is to hold field data is that nothing inside it
# is ever tracked.
py_data/

audit_log.txt
repro_log.txt
tilt_out.txt
*_log.txt
screening*.txt
